// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  cref      String?
  crefito   String?
  evolucoes Evolucao[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Movimento {
  id        String   @id @default(cuid())
  nome      String   @unique
  grauIdeal String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id         String      @id @default(cuid())
  name       String      @unique
  exercicios Exercicio[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Exercicio {
  id         String          @id @default(cuid())
  name       String
  categorias Categoria[]
  links      ExercicioLink[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ExercicioLink {
  id          String    @id @default(cuid())
  url         String
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

enum TipoCampoExame {
  NUMERO
  TEXTO
  MULTIPLA_ESCOLHA
  SIM_NAO
  GONIOMETRIA
  MEMBRO
}

enum DirecaoIdealCampo {
  MAIOR_MELHOR
  MENOR_MELHOR
  PROXIMO_IDEAL
}

enum TipoExame {
  FISIOTERAPIA
  EDUCACAO_FISICA
}

model Exame {
  id            String          @id @default(cuid())
  nome          String
  descricao     String?
  tipo          TipoExame       @default(FISIOTERAPIA)
  versaoAtual   Boolean         @default(true)
  exameOrigemId String?
  origem        Exame?          @relation("VersoesExame", fields: [exameOrigemId], references: [id], onDelete: SetNull)
  versoes       Exame[]         @relation("VersoesExame")
  secoes        ExameSecao[]
  execucoes     ExameExecucao[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([versaoAtual])
}

model ExameSecao {
  id        String        @id @default(cuid())
  nome      String
  ordem     Int
  exameId   String
  exame     Exame         @relation(fields: [exameId], references: [id], onDelete: Cascade)
  campos    ExameCampo[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ExameCampo {
  id        String               @id @default(cuid())
  nome      String
  ordem     Int
  repetivel Boolean              @default(false)
  identificarMembro Boolean      @default(false)
  secaoId   String
  secao     ExameSecao           @relation(fields: [secaoId], references: [id], onDelete: Cascade)
  colunas   ExameCampoColuna[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ExameCampoColuna {
  id           String              @id @default(cuid())
  titulo       String
  ordem        Int
  tipo         TipoCampoExame
  formatacao   String?
  opcoes       String[]            @default([])
  multiplaSelecao Boolean          @default(false)
  valorIdeal   String?
  direcaoIdeal DirecaoIdealCampo?
  campoId      String
  campo        ExameCampo          @relation(fields: [campoId], references: [id], onDelete: Cascade)
  valores      ExameExecucaoValor[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Paciente {
  id                    String          @id @default(cuid())
  nome                  String
  idade                 Int?
  dataNascimento        DateTime?
  cpf                   String?         @unique
  contato               String?
  endereco              String?
  historicoClinico      String?
  objetivo              String?
  doencasPreexistentes  String?
  cirurgiasAnteriores   String?
  medicamentos          String?
  numeroIndicacao       String?
  pessoaIndicacao       String?
  execucoes             ExameExecucao[]
  evolucoes             Evolucao[]
  cobrancas             Cobranca[]
  agendamentos          Agendamento[]
  planoAtribuicoes      PlanoAtribuicao[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Evolucao {
  id             String   @id @default(cuid())
  data           DateTime @default(now())
  profissionalId String
  profissional   User     @relation(fields: [profissionalId], references: [id])
  hdp            String
  hda            String
  pa             String
  fc             String
  spo2           String
  fr             String
  temperatura    String
  auscultaPulmonar String?
  evolucao       String
  conduta        String
  pacienteId     String
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum StatusCobranca {
  PENDENTE
  PAGO
}

model Cobranca {
  id                String           @id @default(cuid())
  pacienteId        String
  paciente          Paciente         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planoNome         String
  valor             Decimal          @db.Decimal(10, 2)
  vencimento        DateTime
  status            StatusCobranca   @default(PENDENTE)
  pagoEm            DateTime?
  observacao        String?
  planoAtribuicaoId String?
  planoAtribuicao   PlanoAtribuicao? @relation(fields: [planoAtribuicaoId], references: [id], onDelete: SetNull)
  numeroParcela     Int?
  totalParcelas     Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([vencimento])
  @@index([status])
  @@index([planoAtribuicaoId])
}

enum StatusPlanoAtribuicao {
  ATIVO
  CANCELADO
  CONCLUIDO
}

enum TipoPlano {
  FISIOTERAPIA
  EDUCACAO_FISICA
}

model Plano {
  id             String            @id @default(cuid())
  nome           String            @unique
  descricao      String?
  tipos          TipoPlano[]
  taxaCartao     Decimal           @default(0) @db.Decimal(5, 2)
  opcoes         PlanoOpcao[]
  atribuicoes    PlanoAtribuicao[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model PlanoOpcao {
  id            String            @id @default(cuid())
  planoId       String
  plano         Plano             @relation(fields: [planoId], references: [id], onDelete: Cascade)
  atendimentos  Int
  valor         Decimal           @db.Decimal(10, 2)
  ordem         Int               @default(0)
  atribuicoes   PlanoAtribuicao[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model PlanoAtribuicao {
  id             String                @id @default(cuid())
  pacienteId     String
  paciente       Paciente              @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planoId        String?
  plano          Plano?                @relation(fields: [planoId], references: [id], onDelete: SetNull)
  planoOpcaoId   String?
  planoOpcao     PlanoOpcao?           @relation(fields: [planoOpcaoId], references: [id], onDelete: SetNull)
  planoNome      String
  atendimentos   Int?
  valor          Decimal               @db.Decimal(10, 2)
  cartao         Boolean               @default(false)
  taxaCartao     Decimal               @default(0) @db.Decimal(5, 2)
  numeroParcelas Int
  dataInicio     DateTime
  status         StatusPlanoAtribuicao @default(ATIVO)
  cobrancas      Cobranca[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([pacienteId])
}

enum TipoAgendamento {
  AVALIACAO
  RETORNO
  SESSAO
}

enum StatusAgendamento {
  AGENDADO
  COMPARECEU
  FALTOU
  CANCELADO
}

model Agendamento {
  id         String            @id @default(cuid())
  pacienteId String
  paciente   Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dataHora   DateTime
  tipo       TipoAgendamento   @default(RETORNO)
  status     StatusAgendamento @default(AGENDADO)
  observacao String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([dataHora])
  @@index([status])
}

enum TipoExecucaoExame {
  AVALIACAO
  RETORNO
}

model ExameExecucao {
  id           String               @id @default(cuid())
  tipo         TipoExecucaoExame
  data         DateTime             @default(now())
  exameId      String
  exame        Exame                @relation(fields: [exameId], references: [id], onDelete: Cascade)
  pacienteId   String
  paciente     Paciente             @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  avaliacaoId  String?
  avaliacao    ExameExecucao?       @relation("AvaliacaoRetornos", fields: [avaliacaoId], references: [id], onDelete: Cascade)
  retornos     ExameExecucao[]      @relation("AvaliacaoRetornos")
  valores      ExameExecucaoValor[]
  createdAt    DateTime             @default(now())
}

model ExameExecucaoValor {
  id          String        @id @default(cuid())
  valor       String
  linha       Int           @default(0)
  execucaoId  String
  execucao    ExameExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  colunaId    String
  coluna      ExameCampoColuna @relation(fields: [colunaId], references: [id], onDelete: Cascade)
}
