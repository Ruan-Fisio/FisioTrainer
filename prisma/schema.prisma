// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  password           String
  cref               String?
  crefito            String?
  cpfCnpj            String?
  razaoSocial        String?
  inscricaoMunicipal String?
  telefone           String?
  endereco           String?
  atendeFisioterapia   Boolean  @default(false)
  atendeEducacaoFisica Boolean  @default(false)
  evolucoes          Evolucao[]
  agendamentos       Agendamento[]
  gradesRecorrentes  GradeRecorrenteAtendimento[] @relation("GradeRecorrenteProfissional")
  servicos           UsuarioServico[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Movimento {
  id        String   @id @default(cuid())
  nome      String   @unique
  grauIdeal String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id         String      @id @default(cuid())
  name       String      @unique
  exercicios Exercicio[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Exercicio {
  id                  String               @id @default(cuid())
  name                String
  categorias          Categoria[]
  links               ExercicioLink[]
  treinoDiaExercicios TreinoDiaExercicio[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ExercicioLink {
  id          String    @id @default(cuid())
  url         String
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

enum TipoCampoExame {
  NUMERO
  TEXTO
  MULTIPLA_ESCOLHA
  SIM_NAO
  GONIOMETRIA
  MEMBRO
}

enum DirecaoIdealCampo {
  MAIOR_MELHOR
  MENOR_MELHOR
  PROXIMO_IDEAL
}

enum TipoExame {
  FISIOTERAPIA
  EDUCACAO_FISICA
}

model Exame {
  id            String          @id @default(cuid())
  nome          String
  descricao     String?
  tipo          TipoExame       @default(FISIOTERAPIA)
  versaoAtual   Boolean         @default(true)
  exameOrigemId String?
  origem        Exame?          @relation("VersoesExame", fields: [exameOrigemId], references: [id], onDelete: SetNull)
  versoes       Exame[]         @relation("VersoesExame")
  secoes        ExameSecao[]
  execucoes     ExameExecucao[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([versaoAtual])
}

model ExameSecao {
  id        String        @id @default(cuid())
  nome      String
  ordem     Int
  exameId   String
  exame     Exame         @relation(fields: [exameId], references: [id], onDelete: Cascade)
  campos    ExameCampo[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ExameCampo {
  id        String               @id @default(cuid())
  nome      String
  ordem     Int
  repetivel Boolean              @default(false)
  identificarMembro Boolean      @default(false)
  secaoId   String
  secao     ExameSecao           @relation(fields: [secaoId], references: [id], onDelete: Cascade)
  colunas   ExameCampoColuna[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ExameCampoColuna {
  id           String              @id @default(cuid())
  titulo       String
  ordem        Int
  tipo         TipoCampoExame
  formatacao   String?
  opcoes       String[]            @default([])
  multiplaSelecao Boolean          @default(false)
  valorIdeal   String?
  direcaoIdeal DirecaoIdealCampo?
  campoId      String
  campo        ExameCampo          @relation(fields: [campoId], references: [id], onDelete: Cascade)
  valores      ExameExecucaoValor[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Paciente {
  id                    String          @id @default(cuid())
  nome                  String
  idade                 Int?
  dataNascimento        DateTime?
  cpf                   String?         @unique
  email                 String?
  contato               String?
  endereco              String?
  historicoClinico      String?
  objetivo              String?
  doencasPreexistentes  String?
  cirurgiasAnteriores   String?
  medicamentos          String?
  numeroIndicacao       String?
  pessoaIndicacao       String?
  execucoes             ExameExecucao[]
  evolucoes             Evolucao[]
  cobrancas             Cobranca[]
  agendamentos          Agendamento[]
  planoAtribuicoes      PlanoAtribuicao[]
  treinos               Treino[]
  acessosCompartilhados AcessoCompartilhadoPaciente[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

/// Link público (sem login) para o paciente ver suas avaliações, evoluções, treinos,
/// planos e financeiro e fazer agendamentos pelo plano ativo. O token na URL é o segredo;
/// `ativo`/`expiraEm` permitem revogar/expirar. Rota: /compartilhado/paciente/<token>.
model AcessoCompartilhadoPaciente {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  pacienteId     String
  paciente       Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  ativo          Boolean   @default(true)
  expiraEm       DateTime?
  ultimoAcessoEm DateTime?
  criadoEm       DateTime  @default(now())

  @@index([pacienteId])
}

model Evolucao {
  id             String   @id @default(cuid())
  data           DateTime @default(now())
  profissionalId String
  profissional   User     @relation(fields: [profissionalId], references: [id])
  hdp            String
  hda            String
  pa             String
  fc             String
  spo2           String
  fr             String
  temperatura    String
  auscultaPulmonar String?
  evolucao       String
  conduta        String
  pacienteId     String
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum StatusCobranca {
  PENDENTE
  PAGO
}

model Cobranca {
  id                String           @id @default(cuid())
  pacienteId        String
  paciente          Paciente         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planoNome         String
  valorBase         Decimal?         @db.Decimal(10, 2)
  valor             Decimal          @db.Decimal(10, 2)
  vencimento        DateTime
  status            StatusCobranca   @default(PENDENTE)
  pagoEm            DateTime?
  observacao        String?
  planoAtribuicaoId String?
  planoAtribuicao   PlanoAtribuicao? @relation(fields: [planoAtribuicaoId], references: [id], onDelete: SetNull)
  numeroParcela     Int?
  totalParcelas     Int?
  notaFiscal        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([vencimento])
  @@index([status])
  @@index([planoAtribuicaoId])
}

enum StatusPlanoAtribuicao {
  ATIVO
  CANCELADO
  CONCLUIDO
}

enum TipoPlano {
  FISIOTERAPIA
  EDUCACAO_FISICA
}

enum FormaPagamentoPlano {
  A_VISTA
  ATE_3X_CARTAO
}

enum PeriodicidadePlano {
  MENSAL
  TRIMESTRAL
}

model Plano {
  id                         String              @id @default(cuid())
  nome                       String              @unique
  descricao                  String?
  tipos                      TipoPlano[]
  atendimentos               Int
  creditosRemarcacao         Int                 @default(0)
  valorAVistaMensal          Decimal             @db.Decimal(10, 2)
  valorAVistaTrimestral      Decimal             @db.Decimal(10, 2)
  valorAte3xTrimestral       Decimal             @db.Decimal(10, 2)
  salas                      PlanoSala[]
  atribuicoes                PlanoAtribuicao[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

/// Salas em que um Plano pode ser executado (Fisioterapia/Educação Física). Ao agendar
/// pelo plano, o sistema tenta cada sala nesta lista, na ordem de `Sala.ordem`, e usa a
/// primeira com vaga (`src/lib/sala-plano.ts` + `resolverSalaPlano` em
/// `agendamento-checagens.ts`). `descricao` é um texto livre sobre o uso daquela sala
/// para este plano (ex. "usa a Sala 2 para uso de equipamentos"), editável no cadastro
/// do Plano. Um plano de Fisioterapia/Educação Física sem nenhuma sala aqui bloqueia
/// agendamento (nunca cria sem sala) — configuração obrigatória.
model PlanoSala {
  id        String   @id @default(cuid())
  planoId   String
  plano     Plano    @relation(fields: [planoId], references: [id], onDelete: Cascade)
  salaId    String
  sala      Sala     @relation(fields: [salaId], references: [id], onDelete: Restrict)
  descricao String?
  createdAt DateTime @default(now())

  @@unique([planoId, salaId])
  @@index([salaId])
}

model PlanoAtribuicao {
  id             String                @id @default(cuid())
  pacienteId     String
  paciente       Paciente              @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planoId        String?
  plano          Plano?                @relation(fields: [planoId], references: [id], onDelete: SetNull)
  planoNome      String
  atendimentos   Int?
  creditosRemarcacao Int             @default(0)
  formaPagamento FormaPagamentoPlano
  periodicidade  PeriodicidadePlano    @default(MENSAL)
  valorOriginal  Decimal               @db.Decimal(10, 2)
  desconto       Decimal               @default(0) @db.Decimal(10, 2)
  valor          Decimal               @db.Decimal(10, 2)
  cartao         Boolean               @default(false)
  notaFiscal     Boolean               @default(false)
  numeroParcelas Int
  dataInicio     DateTime
  status         StatusPlanoAtribuicao @default(ATIVO)
  cobrancas      Cobranca[]
  agendamentos   Agendamento[]
  creditosRemarcacaoUsados CreditoRemarcacao[]
  gradeRecorrente GradeRecorrenteAtendimento[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([pacienteId])
}

/// Modelo semanal de atendimento de um plano atribuído: cada linha = 1 (dia da semana +
/// horário + profissional) que se repete toda semana enquanto o plano estiver ATIVO.
/// Um gerador (src/actions/grade-recorrente.ts) materializa `Agendamento`s a partir daqui
/// para um horizonte rolante (mês atual + próximo), respeitando limite mensal do plano,
/// capacidade de sala e conflito de profissional. Editável na aba "Agendamentos" do paciente.
model GradeRecorrenteAtendimento {
  id                String                @id @default(cuid())
  planoAtribuicaoId String
  planoAtribuicao   PlanoAtribuicao       @relation(fields: [planoAtribuicaoId], references: [id], onDelete: Cascade)
  modalidade        ModalidadeAgendamento
  diaSemana         DiaSemana
  horario           String
  profissionalId    String?
  profissional      User?                 @relation("GradeRecorrenteProfissional", fields: [profissionalId], references: [id], onDelete: SetNull)
  ativo             Boolean               @default(true)
  agendamentos      Agendamento[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([planoAtribuicaoId])
}

enum ModalidadeAgendamento {
  EDUCACAO_FISICA
  FISIOTERAPIA
  AVALIACAO
  TERAPIA_MANUAL
  /// Serviço customizado (ver model `Servico`) — a modalidade específica fica em
  /// `Agendamento.servico`, não é mais um valor fixo deste enum.
  OUTRO
}

/// Serviço cadastrável pela clínica além de Fisioterapia/Educação Física (ex. Psicologia,
/// Nutrição). Usado só para agendamento pontual manual (sem grade recorrente/orçamento de
/// plano) — ver `criarAgendamentoServico` em src/actions/agendamentos.ts. Sala/capacidade
/// (`SalaServico`) e profissionais habilitados (`UsuarioServico`) são camadas novas e
/// aditivas, paralelas às colunas fixas de `Sala`/`User` usadas por Fisioterapia/Educação
/// Física — nunca as substituem, para não arriscar o fluxo de Plano já em produção.
model Servico {
  id            String           @id @default(cuid())
  nome          String           @unique
  ativo         Boolean          @default(true)
  salas         SalaServico[]
  profissionais UsuarioServico[]
  agendamentos  Agendamento[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// Salas em que um Servico customizado pode ser executado, com capacidade própria —
/// equivalente ao `PlanoSala`, mas para serviços fora do fluxo de Plano.
model SalaServico {
  id         String   @id @default(cuid())
  salaId     String
  sala       Sala     @relation(fields: [salaId], references: [id], onDelete: Cascade)
  servicoId  String
  servico    Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  capacidade Int
  descricao  String?
  createdAt  DateTime @default(now())

  @@unique([salaId, servicoId])
  @@index([servicoId])
}

/// Profissionais habilitados a atender um Servico customizado — substitui, só para esses
/// serviços novos, o padrão de booleans fixos (`User.atendeFisioterapia`/`atendeEducacaoFisica`).
model UsuarioServico {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   User    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, servicoId])
  @@index([servicoId])
}

enum StatusAgendamento {
  AGENDADO
  COMPARECEU
  FALTOU
  CANCELADO
}

model Agendamento {
  id             String                @id @default(cuid())
  titulo         String
  pacientes      Paciente[]
  profissionalId String?
  profissional   User?                 @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  dataInicio     DateTime              @db.Timestamptz(3)
  dataFim        DateTime              @db.Timestamptz(3)
  diaInteiro     Boolean               @default(false)
  modalidade     ModalidadeAgendamento @default(FISIOTERAPIA)
  status         StatusAgendamento     @default(AGENDADO)
  observacao     String?
  serieId        String?
  planoAtribuicaoId String?
  planoAtribuicao   PlanoAtribuicao? @relation(fields: [planoAtribuicaoId], references: [id], onDelete: SetNull)
  gradeRecorrenteId String?
  gradeRecorrente   GradeRecorrenteAtendimento? @relation(fields: [gradeRecorrenteId], references: [id], onDelete: SetNull)
  /// Data-calendário (Brasília) que a grade recorrente pretendia para este agendamento.
  /// Chave de idempotência do gerador; permanece no dia original mesmo após remarcação.
  slotData       DateTime?             @db.Date
  /// Sala escolhida automaticamente entre as salas cadastradas no Plano (Fisioterapia/
  /// Educação Física) — ver `PlanoSala`. Nula para Avaliação/Terapia Manual (sala fixa,
  /// `MODALIDADE_SALA_PADRAO`) e para agendamentos antigos anteriores a esse recurso.
  salaId         String?
  sala           Sala?                 @relation(fields: [salaId], references: [id], onDelete: SetNull)
  /// Preenchido só quando `modalidade === OUTRO` (serviço customizado, ver model `Servico`).
  servicoId      String?
  servico        Servico?              @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  creditosRemarcacao CreditoRemarcacao[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([dataInicio])
  @@index([status])
  @@index([serieId])
  @@index([modalidade])
  @@index([planoAtribuicaoId])
  @@index([gradeRecorrenteId])
  @@index([salaId])
  @@index([servicoId])
}

enum OrigemRemarcacao {
  PACIENTE
  CLINICA
}

/// Trilha de consumo de créditos de remarcação de um plano. Cada linha = 1 crédito
/// consumido no mês (contado por `createdAt`, janela mês-calendário de Brasília).
/// Criada quando o paciente desmarca pelo portal (dentro do prazo) ou a clínica
/// remarca pelo wizard "Remarcar" um agendamento ligado a um plano.
model CreditoRemarcacao {
  id                String           @id @default(cuid())
  planoAtribuicaoId String
  planoAtribuicao   PlanoAtribuicao  @relation(fields: [planoAtribuicaoId], references: [id], onDelete: Cascade)
  agendamentoId     String?
  agendamento       Agendamento?     @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  origem            OrigemRemarcacao
  justificativa     String
  createdAt         DateTime         @default(now())

  @@index([planoAtribuicaoId, createdAt])
}

/// Horários de atendimento pré-configurados por modalidade (usados para Educação Física e
/// Fisioterapia, que têm grade fixa de horários; Avaliação e Terapia Manual usam horário livre).
model HorarioAtendimento {
  id         String                @id @default(cuid())
  modalidade ModalidadeAgendamento
  horario    String
  duracaoMin Int                   @default(50)
  ativo      Boolean               @default(true)
  ordem      Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([modalidade, horario])
  @@index([modalidade])
}

/// Salas de Educação Física / Fisioterapia da clínica. Toda sala tem capacidade (pessoas
/// por horário) para as duas modalidades. Configurável na aba Salas de /configuracoes.
/// Avaliação e Terapia Manual não usam este model (ficam fixas em src/lib/salas.ts).
model Sala {
  id                       String        @id @default(cuid())
  nome                     String        @unique
  ordem                    Int           @default(0)
  capacidadeEducacaoFisica Int           @default(0)
  capacidadeFisioterapia   Int           @default(0)
  planos                   PlanoSala[]
  servicos                 SalaServico[]
  agendamentos             Agendamento[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
}

/// Dias da semana em que a clínica atende. Uma linha por dia (0..6 → DOMINGO..SÁBADO
/// via `DiaSemana`). `aberto = false` bloqueia qualquer agendamento nesse dia da semana.
/// Configurável na aba "Funcionamento" de /configuracoes.
model DiaFuncionamento {
  id        String    @id @default(cuid())
  diaSemana DiaSemana @unique
  aberto    Boolean   @default(true)
  updatedAt DateTime  @updatedAt
}

/// Feriados / datas em que a clínica não atende (bloqueiam agendamento naquele dia).
/// Configurável na aba "Funcionamento" de /configuracoes.
model Feriado {
  id        String   @id @default(cuid())
  data      DateTime @unique @db.Date
  descricao String
  createdAt DateTime @default(now())
}

enum TipoExecucaoExame {
  AVALIACAO
  RETORNO
}

model ExameExecucao {
  id           String               @id @default(cuid())
  tipo         TipoExecucaoExame
  data         DateTime             @default(now())
  exameId      String
  exame        Exame                @relation(fields: [exameId], references: [id], onDelete: Cascade)
  pacienteId   String
  paciente     Paciente             @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  avaliacaoId  String?
  avaliacao    ExameExecucao?       @relation("AvaliacaoRetornos", fields: [avaliacaoId], references: [id], onDelete: Cascade)
  retornos     ExameExecucao[]      @relation("AvaliacaoRetornos")
  valores      ExameExecucaoValor[]
  createdAt    DateTime             @default(now())
}

model ExameExecucaoValor {
  id          String        @id @default(cuid())
  valor       String
  linha       Int           @default(0)
  execucaoId  String
  execucao    ExameExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  colunaId    String
  coluna      ExameCampoColuna @relation(fields: [colunaId], references: [id], onDelete: Cascade)
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Treino {
  id             String      @id @default(cuid())
  nome           String
  descricao      String?
  pacienteId     String?
  paciente       Paciente?   @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  treinoOrigemId String?
  origem         Treino?     @relation("TreinoOrigem", fields: [treinoOrigemId], references: [id], onDelete: SetNull)
  copias         Treino[]    @relation("TreinoOrigem")
  dataInicio     DateTime?
  dataFim        DateTime?
  ativo          Boolean     @default(true)
  dias           TreinoDia[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([pacienteId])
}

model TreinoDia {
  id         String               @id @default(cuid())
  treinoId   String
  treino     Treino               @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  diaSemana  DiaSemana
  ordem      Int                  @default(0)
  exercicios TreinoDiaExercicio[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([treinoId])
}

model TreinoDiaExercicio {
  id          String    @id @default(cuid())
  treinoDiaId String
  treinoDia   TreinoDia @relation(fields: [treinoDiaId], references: [id], onDelete: Cascade)
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
  ordem       Int       @default(0)
  series      Int?
  repeticoes  String?
  carga       Decimal? @db.Decimal(6, 2)
  descanso    Int?
  instrucoes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([treinoDiaId])
}

/// Registro de auditoria: toda operação de escrita (create/update/delete) em qualquer
/// model é gravada aqui automaticamente pela extensão do Prisma Client (src/lib/prisma.ts).
/// Visível na tela /logs. Nunca é lido/escrito manualmente pelas server actions.
model AuditLog {
  id          String   @id @default(cuid())
  criadoEm    DateTime @default(now())
  usuarioId   String?
  usuarioNome String?
  modulo      String
  acao        String
  registroId  String?
  resumo      String
  dados       Json?

  @@index([criadoEm])
  @@index([modulo])
  @@index([acao])
  @@index([usuarioId])
}
