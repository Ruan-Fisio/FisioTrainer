// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  password           String
  cref               String?
  crefito            String?
  cpfCnpj            String?
  razaoSocial        String?
  inscricaoMunicipal String?
  telefone           String?
  endereco           String?
  evolucoes          Evolucao[]
  agendamentos       Agendamento[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Movimento {
  id        String   @id @default(cuid())
  nome      String   @unique
  grauIdeal String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id         String      @id @default(cuid())
  name       String      @unique
  exercicios Exercicio[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Exercicio {
  id                  String               @id @default(cuid())
  name                String
  categorias          Categoria[]
  links               ExercicioLink[]
  treinoDiaExercicios TreinoDiaExercicio[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ExercicioLink {
  id          String    @id @default(cuid())
  url         String
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

enum TipoCampoExame {
  NUMERO
  TEXTO
  MULTIPLA_ESCOLHA
  SIM_NAO
  GONIOMETRIA
  MEMBRO
}

enum DirecaoIdealCampo {
  MAIOR_MELHOR
  MENOR_MELHOR
  PROXIMO_IDEAL
}

enum TipoExame {
  FISIOTERAPIA
  EDUCACAO_FISICA
}

model Exame {
  id            String          @id @default(cuid())
  nome          String
  descricao     String?
  tipo          TipoExame       @default(FISIOTERAPIA)
  versaoAtual   Boolean         @default(true)
  exameOrigemId String?
  origem        Exame?          @relation("VersoesExame", fields: [exameOrigemId], references: [id], onDelete: SetNull)
  versoes       Exame[]         @relation("VersoesExame")
  secoes        ExameSecao[]
  execucoes     ExameExecucao[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([versaoAtual])
}

model ExameSecao {
  id        String        @id @default(cuid())
  nome      String
  ordem     Int
  exameId   String
  exame     Exame         @relation(fields: [exameId], references: [id], onDelete: Cascade)
  campos    ExameCampo[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ExameCampo {
  id        String               @id @default(cuid())
  nome      String
  ordem     Int
  repetivel Boolean              @default(false)
  identificarMembro Boolean      @default(false)
  secaoId   String
  secao     ExameSecao           @relation(fields: [secaoId], references: [id], onDelete: Cascade)
  colunas   ExameCampoColuna[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ExameCampoColuna {
  id           String              @id @default(cuid())
  titulo       String
  ordem        Int
  tipo         TipoCampoExame
  formatacao   String?
  opcoes       String[]            @default([])
  multiplaSelecao Boolean          @default(false)
  valorIdeal   String?
  direcaoIdeal DirecaoIdealCampo?
  campoId      String
  campo        ExameCampo          @relation(fields: [campoId], references: [id], onDelete: Cascade)
  valores      ExameExecucaoValor[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Paciente {
  id                    String          @id @default(cuid())
  nome                  String
  idade                 Int?
  dataNascimento        DateTime?
  cpf                   String?         @unique
  email                 String?
  contato               String?
  endereco              String?
  historicoClinico      String?
  objetivo              String?
  doencasPreexistentes  String?
  cirurgiasAnteriores   String?
  medicamentos          String?
  numeroIndicacao       String?
  pessoaIndicacao       String?
  execucoes             ExameExecucao[]
  evolucoes             Evolucao[]
  cobrancas             Cobranca[]
  agendamentos          Agendamento[]
  planoAtribuicoes      PlanoAtribuicao[]
  treinos               Treino[]
  acessosCompartilhados AcessoCompartilhadoPaciente[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

/// Link público (sem login) para o paciente ver suas avaliações, evoluções, treinos,
/// planos e financeiro e fazer agendamentos pelo plano ativo. O token na URL é o segredo;
/// `ativo`/`expiraEm` permitem revogar/expirar. Rota: /compartilhado/paciente/<token>.
model AcessoCompartilhadoPaciente {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  pacienteId     String
  paciente       Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  ativo          Boolean   @default(true)
  expiraEm       DateTime?
  ultimoAcessoEm DateTime?
  criadoEm       DateTime  @default(now())

  @@index([pacienteId])
}

model Evolucao {
  id             String   @id @default(cuid())
  data           DateTime @default(now())
  profissionalId String
  profissional   User     @relation(fields: [profissionalId], references: [id])
  hdp            String
  hda            String
  pa             String
  fc             String
  spo2           String
  fr             String
  temperatura    String
  auscultaPulmonar String?
  evolucao       String
  conduta        String
  pacienteId     String
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum StatusCobranca {
  PENDENTE
  PAGO
}

model Cobranca {
  id                String           @id @default(cuid())
  pacienteId        String
  paciente          Paciente         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planoNome         String
  valorBase         Decimal?         @db.Decimal(10, 2)
  valor             Decimal          @db.Decimal(10, 2)
  vencimento        DateTime
  status            StatusCobranca   @default(PENDENTE)
  pagoEm            DateTime?
  observacao        String?
  planoAtribuicaoId String?
  planoAtribuicao   PlanoAtribuicao? @relation(fields: [planoAtribuicaoId], references: [id], onDelete: SetNull)
  numeroParcela     Int?
  totalParcelas     Int?
  notaFiscal        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([vencimento])
  @@index([status])
  @@index([planoAtribuicaoId])
}

enum StatusPlanoAtribuicao {
  ATIVO
  CANCELADO
  CONCLUIDO
}

enum TipoPlano {
  FISIOTERAPIA
  EDUCACAO_FISICA
}

enum FormaPagamentoPlano {
  A_VISTA
  A_VISTA_NF
  ATE_3X_CARTAO
  ATE_3X_NF
}

enum PeriodicidadePlano {
  MENSAL
  TRIMESTRAL
}

model Plano {
  id                         String              @id @default(cuid())
  nome                       String              @unique
  descricao                  String?
  tipos                      TipoPlano[]
  atendimentos               Int
  valorAVistaMensal          Decimal             @db.Decimal(10, 2)
  valorAVistaTrimestral      Decimal             @db.Decimal(10, 2)
  valorAVistaNfMensal        Decimal             @db.Decimal(10, 2)
  valorAVistaNfTrimestral    Decimal             @db.Decimal(10, 2)
  valorAte3xCartaoMensal     Decimal             @db.Decimal(10, 2)
  valorAte3xCartaoTrimestral Decimal             @db.Decimal(10, 2)
  valorAte3xNfMensal         Decimal             @db.Decimal(10, 2)
  valorAte3xNfTrimestral     Decimal             @db.Decimal(10, 2)
  atribuicoes                PlanoAtribuicao[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

model PlanoAtribuicao {
  id             String                @id @default(cuid())
  pacienteId     String
  paciente       Paciente              @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planoId        String?
  plano          Plano?                @relation(fields: [planoId], references: [id], onDelete: SetNull)
  planoNome      String
  atendimentos   Int?
  formaPagamento FormaPagamentoPlano
  periodicidade  PeriodicidadePlano    @default(MENSAL)
  valorOriginal  Decimal               @db.Decimal(10, 2)
  desconto       Decimal               @default(0) @db.Decimal(10, 2)
  valor          Decimal               @db.Decimal(10, 2)
  cartao         Boolean               @default(false)
  notaFiscal     Boolean               @default(false)
  numeroParcelas Int
  dataInicio     DateTime
  status         StatusPlanoAtribuicao @default(ATIVO)
  cobrancas      Cobranca[]
  agendamentos   Agendamento[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([pacienteId])
}

enum ModalidadeAgendamento {
  EDUCACAO_FISICA
  FISIOTERAPIA
  AVALIACAO
  TERAPIA_MANUAL
}

enum StatusAgendamento {
  AGENDADO
  COMPARECEU
  FALTOU
  CANCELADO
}

model Agendamento {
  id             String                @id @default(cuid())
  titulo         String
  pacientes      Paciente[]
  profissionalId String?
  profissional   User?                 @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  dataInicio     DateTime              @db.Timestamptz(3)
  dataFim        DateTime              @db.Timestamptz(3)
  diaInteiro     Boolean               @default(false)
  modalidade     ModalidadeAgendamento @default(FISIOTERAPIA)
  status         StatusAgendamento     @default(AGENDADO)
  observacao     String?
  serieId        String?
  planoAtribuicaoId String?
  planoAtribuicao   PlanoAtribuicao? @relation(fields: [planoAtribuicaoId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([dataInicio])
  @@index([status])
  @@index([serieId])
  @@index([modalidade])
  @@index([planoAtribuicaoId])
}

/// Horários de atendimento pré-configurados por modalidade (usados para Educação Física e
/// Fisioterapia, que têm grade fixa de horários; Avaliação e Terapia Manual usam horário livre).
model HorarioAtendimento {
  id         String                @id @default(cuid())
  modalidade ModalidadeAgendamento
  horario    String
  duracaoMin Int                   @default(50)
  ativo      Boolean               @default(true)
  ordem      Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([modalidade, horario])
  @@index([modalidade])
}

enum TipoExecucaoExame {
  AVALIACAO
  RETORNO
}

model ExameExecucao {
  id           String               @id @default(cuid())
  tipo         TipoExecucaoExame
  data         DateTime             @default(now())
  exameId      String
  exame        Exame                @relation(fields: [exameId], references: [id], onDelete: Cascade)
  pacienteId   String
  paciente     Paciente             @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  avaliacaoId  String?
  avaliacao    ExameExecucao?       @relation("AvaliacaoRetornos", fields: [avaliacaoId], references: [id], onDelete: Cascade)
  retornos     ExameExecucao[]      @relation("AvaliacaoRetornos")
  valores      ExameExecucaoValor[]
  createdAt    DateTime             @default(now())
}

model ExameExecucaoValor {
  id          String        @id @default(cuid())
  valor       String
  linha       Int           @default(0)
  execucaoId  String
  execucao    ExameExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  colunaId    String
  coluna      ExameCampoColuna @relation(fields: [colunaId], references: [id], onDelete: Cascade)
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Treino {
  id             String      @id @default(cuid())
  nome           String
  descricao      String?
  pacienteId     String?
  paciente       Paciente?   @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  treinoOrigemId String?
  origem         Treino?     @relation("TreinoOrigem", fields: [treinoOrigemId], references: [id], onDelete: SetNull)
  copias         Treino[]    @relation("TreinoOrigem")
  dataInicio     DateTime?
  dataFim        DateTime?
  ativo          Boolean     @default(true)
  dias           TreinoDia[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([pacienteId])
}

model TreinoDia {
  id         String               @id @default(cuid())
  treinoId   String
  treino     Treino               @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  diaSemana  DiaSemana
  ordem      Int                  @default(0)
  exercicios TreinoDiaExercicio[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([treinoId])
}

model TreinoDiaExercicio {
  id          String    @id @default(cuid())
  treinoDiaId String
  treinoDia   TreinoDia @relation(fields: [treinoDiaId], references: [id], onDelete: Cascade)
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
  ordem       Int       @default(0)
  series      Int?
  repeticoes  String?
  carga       Decimal? @db.Decimal(6, 2)
  descanso    Int?
  instrucoes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([treinoDiaId])
}

/// Registro de auditoria: toda operação de escrita (create/update/delete) em qualquer
/// model é gravada aqui automaticamente pela extensão do Prisma Client (src/lib/prisma.ts).
/// Visível na tela /logs. Nunca é lido/escrito manualmente pelas server actions.
model AuditLog {
  id          String   @id @default(cuid())
  criadoEm    DateTime @default(now())
  usuarioId   String?
  usuarioNome String?
  modulo      String
  acao        String
  registroId  String?
  resumo      String
  dados       Json?

  @@index([criadoEm])
  @@index([modulo])
  @@index([acao])
  @@index([usuarioId])
}
